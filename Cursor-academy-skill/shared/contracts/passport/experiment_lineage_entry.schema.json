{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI-CYJ/Cafe-Cursor-Brisbane/Cursor-academy-skill/shared/contracts/passport/experiment_lineage_entry.schema.json",
  "title": "Material Passport Experiment Lineage Entry",
  "description": "One entry in Material Passport Schema 14 experiment_lineage[]. Connects assertions, tables, or figures to specific runs, code commits, dataset versions, and environment parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "code_commit",
    "code_repo",
    "config_hash",
    "dataset_versions",
    "primary_metrics",
    "artifacts",
    "environment",
    "ran_at",
    "ran_by"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^exp_[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-zA-Z0-9_-]+$",
      "description": "Unique identifier for the experimental run. Format: exp_YYYY_MM_DD_slug."
    },
    "code_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "Git commit hash under which the experiment was executed."
    },
    "code_repo": {
      "type": "string",
      "minLength": 1,
      "description": "Repository URL for the code, e.g., github.com/user/project."
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 hash of the configuration parameters/files used for the run."
    },
    "dataset_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "hash"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^(sha256:)?[0-9a-f]{64}$" }
        }
      }
    },
    "primary_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "ci_lower": { "type": "number" },
          "ci_upper": { "type": "number" },
          "ci_method": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "generator"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["figure", "table", "weights", "logs", "other"] },
          "path": { "type": "string", "minLength": 1 },
          "generator": { "type": "string", "minLength": 1 }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["python", "seed"],
      "properties": {
        "python": { "type": "string" },
        "cuda": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },
    "ran_at": {
      "type": "string",
      "format": "date-time"
    },
    "ran_by": {
      "type": "string",
      "minLength": 1
    }
  }
}
